# Escolha o transporte:
# azure_sdk = endpoint-base oficial do Azure OpenAI
# direct = URL completa de gateway/API compatível com OpenAI
LLM_TRANSPORT=direct

# Usado quando LLM_TRANSPORT=azure_sdk
AZURE_OPENAI_ENDPOINT_5=
AZURE_OPENAI_API_VERSION_5=2025-04-01-preview

# Usado quando LLM_TRANSPORT=direct
AZURE_OPENAI_DIRECT_URL_5=
# Valores aceitos: api-key ou bearer
AZURE_OPENAI_AUTH_TYPE_5=api-key

# Usado nos dois modos
AZURE_OPENAI_API_KEY_PRIMARY_5=
AZURE_OPENAI_MODEL_5=gpt-5.4-mini-ptu
REQUEST_TIMEOUT_SECONDS=120

TOP_K=4
MAX_TURNS=8
